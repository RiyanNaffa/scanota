# --- App ---
APP_ENV=development
CONFIDENCE_THRESHOLD=0.85

# --- Database ---
POSTGRES_USER=scanota
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scanota
DATABASE_URL=postgresql://scanota:change-me@db:5432/scanota
# Read-only user, used ONLY by text-to-SQL chat (SELECT permission only)
DATABASE_READONLY_URL=postgresql://scanota_ro:change-me@db:5432/scanota

# --- LLM endpoint (OpenAI-compatible) ---
# Development: AMD Tokenfactory. Final demo: your own vLLM on AMD Developer Cloud.
# Tokenfactory:  LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# Self-hosted:   LLM_BASE_URL=http://<vllm-host>:8080/v1   (see infra/amd/README.md)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_VISION=MiniCPM-V-4.7-35B-A3B
# Optional backup vision model, used for a receipt when the main one fails with 5xx or a
# timeout (after retries). Empty = off. Choose a non-thinking VLM, e.g. DeepSeek-V4.1-Flash.
LLM_MODEL_VISION_FALLBACK=
LLM_MODEL_TEXT=Qwen3.8-27B
LLM_MODEL_LIGHT=MiniCPM5-2B

# --- LLM token budget (Qwen3.8-27B thinks at xhigh by default; these keep it efficient) ---
# Qwen3.8-27B accepts low | medium | xhigh ("high" is rejected with 400). Empty = do not send
# reasoning_effort (for servers that reject it).
# Reasoning tokens count toward max_tokens: too small a budget gives an empty reply
# (finish_reason "length"), which the app logs as a warning.
LLM_REASONING_EFFORT_SQL=medium
LLM_REASONING_EFFORT_TEXT=low
LLM_MAX_TOKENS_SQL=2048
LLM_MAX_TOKENS_ANSWER=1024
LLM_MAX_TOKENS_EXPLAIN=512

# --- LLM retry (429 / 5xx / connection errors; Retry-After is honoured) ---
# Tokenfactory limits are shared by the whole team's key: 30 RPM per key, 20 RPM per account,
# 8 concurrent. Its per-minute 429s send Retry-After: 60, so keep the max at 65 or more.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=1.0
LLM_RETRY_MAX_SECONDS=65.0

# --- OCR (MinerU2.5-Pro, POST {LLM_BASE_URL}/ocr; limited free, billed per page) ---
# Its text is given to the vision model as a hint. Tokenfactory only: set false for self-hosted
# vLLM, which has no /ocr route. If OCR fails, extraction continues with the vision model alone.
OCR_ENABLED=true
OCR_MODEL=MinerU2.5-Pro
OCR_TIMEOUT_SECONDS=60

# --- Read-only DB role (text-to-SQL) ---
POSTGRES_RO_PASSWORD=change-me
# Keep consistent with DATABASE_READONLY_URL above

# --- Reorder policy ---
# safety stock = z * sigma * sqrt(lead time). z is set per category in app/forecast/category_policy.py
# (2.2 goods that keep, 1.8 goods with a shelf life, from `make backtest`). This value is only the
# fallback for categories not listed there. Higher z = fewer stockouts, more stock on hand.
SAFETY_STOCK_Z=2.2

# --- Docker port overrides (optional) ---
# Uncomment to expose Postgres externally (disabled by default)
# POSTGRES_PORT=5432
