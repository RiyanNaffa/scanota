# --- App ---
APP_ENV=development
CONFIDENCE_THRESHOLD=0.85

# --- Database ---
POSTGRES_USER=scanota
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scanota
DATABASE_URL=postgresql://scanota:change-me@db:5432/scanota
# Read-only user, used ONLY by text-to-SQL chat (SELECT permission only)
DATABASE_READONLY_URL=postgresql://scanota_ro:change-me@db:5432/scanota

# --- LLM endpoint (OpenAI-compatible) ---
# Development: AMD Tokenfactory. Final demo: your own vLLM on AMD Developer Cloud.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_VISION=MiniCPM-V-4.7-35B-A3B
LLM_MODEL_TEXT=Qwen3.8-27B
LLM_MODEL_LIGHT=MiniCPM5-2B

# --- Evolus ---
EVOLUS_BASE_URL=
EVOLUS_API_KEY=
EVOLUS_WORKSPACE_ID=

# --- Read-only DB role (text-to-SQL) ---
POSTGRES_RO_PASSWORD=change-me
# Keep consistent with DATABASE_READONLY_URL above

# --- Docker port overrides (optional) ---
# Uncomment to expose Postgres externally (disabled by default)
# POSTGRES_PORT=5432
